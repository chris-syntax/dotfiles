# env.nu — shared, cross-platform Nushell environment  (chezmoi: all OSes)
#
# Loaded before config.nu and login.nu. On macOS this is sourced from
# ~/Library/Application Support/nushell/env.nu AFTER the macOS PATH/Homebrew
# bootstrap; on Linux it is the native XDG entry point. Keep OS-agnostic.

# --- PATH: prepend user-level bin dirs (guard against an unset PATH) ---------
$env.PATH = (
    [
        ($env.HOME | path join '.cargo' 'bin')
        ($env.HOME | path join '.local' 'bin')
        ($env.HOME | path join '.yarn' 'bin')
        ($env.HOME | path join '.config' 'yarn' 'global' 'node_modules' '.bin')
        ($env.HOME | path join '.bun' 'bin')
        ($env.HOME | path join '.lmstudio' 'bin')
    ]
    | append ($env.PATH? | default [])
    | uniq
)

# --- General environment ----------------------------------------------------
$env.EDITOR = 'nvim'
$env.CARGO_HOME = ($env.HOME | path join '.cargo')
$env.PSQL_PAGER = 'pspg -X -b'
$env.GUIA_MARKDOWN = 'glow'
$env.CARAPACE_BRIDGES = 'zsh,fish,bash,inshellisense'
{{ if eq .ownership "work" -}}

# work-only
$env.AWS_DEFAULT_PROFILE = 'syntax-testing'
{{ end -}}

# --- Regenerate tool-integration snippets -----------------------------------
# Write an empty file when a tool is absent so config.nu can source/use it
# unconditionally without a parse-time error — a missing binary must never
# break a login shell.
def gen-init [tool: string, out: string, gen: closure] {
    mkdir ($out | path dirname)
    if (which $tool | is-not-empty) {
        do $gen | save --force $out
    } else if (not ($out | path exists)) {
        '' | save --force $out
    }
}

gen-init 'carapace' ($nu.cache-dir | path join 'carapace.nu')      { ^carapace _carapace nushell }
gen-init 'starship' ($nu.cache-dir | path join 'starship.nu')      { ^starship init nu }
gen-init 'zoxide'   ($nu.cache-dir | path join 'zoxide.nu')        { ^zoxide init nushell }
gen-init 'mise'     ($nu.default-config-dir | path join 'mise.nu') { ^mise activate nu }

# --- Machine-local secrets (chezmoi-ignored); ensure it exists --------------
let secrets_file = ('~/.config/nushell/secrets.nu' | path expand)
if (not ($secrets_file | path exists)) {
    mkdir ($secrets_file | path dirname)
    '# Machine-local secrets — not tracked by chezmoi. Add $env.FOO = "..." here.' | save --force $secrets_file
}
