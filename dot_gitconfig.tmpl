	email = "me@cthomas.dev"
	signingkey = 85450BE38C34576B
[core]
  pager = delta
	excludesfile = {{ joinPath .chezmoi.homeDir ".gitignore_global" }}
[interactive]
  diffFilter = delta --color-only
[commit]
	gpgsign = true
	template = {{ joinPath .chezmoi.homeDir ".stCommitMsg" }}
[delta]
  navigate = true
[merge]
  conflictstyle = diff3
[diff]
  colorMoved = default
[pull]
	rebase = false
[push]
	autoSetupRemote = true
[filter "lfs"]
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
[init]
  defaultBranch = main
